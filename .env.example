# ============================================================
# Telegram RAG-бот — пример конфигурации окружения
#
# Скопируйте и заполните:  cp .env.example .env
# Значения читаются через pydantic-settings (src/core/config.py).
# ============================================================

# ---------- Telegram ----------
# Токен бота, выданный @BotFather
BOT_TOKEN=123456789:replace-with-your-telegram-bot-token

# ---------- LLM / Embeddings ----------
# API-ключ OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
# Базовый URL любого OpenAI-совместимого API.
# Для локальных моделей через Ollama: http://host.docker.internal:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Размерность эмбеддингов (для text-embedding-3-small — 1536)
EMBEDDING_DIM=1536

# ---------- PostgreSQL (пользователи, история, статусы файлов) ----------
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
# Внутри docker compose — имя сервиса; при запуске без Docker — localhost
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Qdrant (векторная БД) ----------
QDRANT_URL=http://qdrant:6333
# Заполняется, только если Qdrant запущен с --api-key
QDRANT_API_KEY=

# ---------- Параметры RAG-пайплайна ----------
# Размер чанка (в токенах) и перекрытие между соседними чанками
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Сколько релевантных чанков передаётся в контекст LLM
TOP_K=5
# Максимальный размер загружаемого PDF (МБ)
MAX_PDF_SIZE_MB=20

# ---------- Приложение ----------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
